{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "node scripts/build-web-preview.cjs",
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/saju", "destination": "/index.html" },
    { "source": "/result", "destination": "/index.html" },
    { "source": "/saved", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/accounts", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/feedback", "destination": "/index.html" },
    { "source": "/feedback/:recId", "destination": "/index.html" },
    { "source": "/place/:id", "destination": "/index.html" },
    { "source": "/diagnosis/personal-color", "destination": "/index.html" },
    { "source": "/diagnosis/body-type", "destination": "/index.html" },
    { "source": "/onboarding/basic", "destination": "/index.html" },
    { "source": "/onboarding/style", "destination": "/index.html" },
    { "source": "/onboarding/traits", "destination": "/index.html" },
    { "source": "/oauth/naver", "destination": "/index.html" }
  ],
  "functions": {
    "deploy/vercel/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{app/**,client/**,tests/**,.github/**,artifacts/**,storage/**,.venv/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://image.istarbucks.co.kr https://postfiles.pstatic.net https://blogfiles.pstatic.net https://cafe24.poxo.com; connect-src 'self' blob: https://www.instagram.com; frame-src https://www.instagram.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), browsing-topics=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
