{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "node scripts/build-web-preview.cjs",
  "functions": {
    "deploy/vercel/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{app/**,client/**,tests/**,.github/**,artifacts/**,storage/**,.venv/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
