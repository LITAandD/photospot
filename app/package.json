{
  "name": "photospot-app",
  "version": "1.0.0",
  "description": "",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "npm --prefix ../client run build",
    "start": "expo start --localhost",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --localhost",
    "demo": "node scripts/start-demo.cjs",
    "typecheck": "node scripts/generate-routes.cjs && tsc --noEmit",
    "export": "expo export --platform all",
    "check:release": "node scripts/check-release.cjs",
    "eas-build-post-install": "npm --prefix ../client ci && npm --prefix ../client run build",
    "test": "node scripts/test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@expo-google-fonts/gowun-batang": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-kr": "^0.4.1",
    "@expo/metro-runtime": "~55.0.12",
    "@photospot/client": "file:../client",
    "@react-native-google-signin/google-signin": "^13.3.1",
    "@react-native-seoul/kakao-login": "^5.4.2",
    "decode-uri-component": "file:compat/decode-uri-component",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-asset": "~55.0.20",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-purchases": "^9.15.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~55.0.11",
    "@types/react": "~19.2.10",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "overrides": {
