# 실기기는 PC의 LAN IP, Android 에뮬레이터는 http://10.0.2.2:8000.
# 운영 빌드는 실제 HTTPS 주소가 필요합니다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_DEV_LOGIN=0
EXPO_PUBLIC_DEMO=0
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_ID=
# 네이버 Callback URL. 비우면 photospot://oauth/naver (비밀키는 서버 NAVER_CLIENT_SECRET에만)
EXPO_PUBLIC_NAVER_REDIRECT_URI=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 정책 문서 공개 HTTPS 주소 4개. 웹 빌드(scripts/build-web-preview.cjs)는 비어 있으면 같은 도메인의 /policies/*.html을 쓴다.
# 스토어 빌드는 절대 주소가 필요하다. 예: https://photospot.litaandd.com/policies/privacy.html
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_LOCATION_TERMS_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
# 고객 문의 이메일. 설정하면 개인정보 안내·후원 화면에 표시되고, 운영 빌드에서는 필수
EXPO_PUBLIC_SUPPORT_EMAIL=
EAS_PROJECT_ID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EXPO_PUBLIC_* 값은 앱에 포함됩니다. 서버 JWT_SECRET/API 비밀키를 넣지 마세요.
