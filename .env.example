# 복사해서 .env 로 쓰고, 운영 값은 비밀 저장소(예: SSM, Vault, GitHub Secrets)에 둔다
APP_ENV=development
DATABASE_URL=postgresql://photospot:photospot@db:5432/photospot
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_ROOT=/data/storage
MEDIA_BASE_URL=/media
ANTHROPIC_API_KEY=
TOURAPI_KEY=
PHOTO_MASKER=none            # rembg 로 바꾸면 인물 제외 (모델 다운로드 필요)

# 소셜 로그인
GOOGLE_CLIENT_IDS=            # iOS,Android,웹 클라이언트 ID를 쉼표로
APPLE_AUDIENCES=app.photospot # 번들 ID (웹 로그인도 쓰면 서비스 ID 추가)
APPLE_CLIENT_ID=app.photospot
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=     # 서버에만 마운트한 Sign in with Apple .p8 파일
APPLE_TOKEN_ENCRYPTION_KEY= # Fernet 키. 서버 비밀 저장소에 보관하고 DB 백업과 분리
RECOMMENDATION_BACKEND=catalog
# Docker 이미지에는 공개 장소 스냅샷 포함. 로컬은 storage/place-catalog.sqlite3 사용
KAKAO_APP_ID=                 # 카카오 개발자 콘솔의 앱 ID (숫자)
DEV_LOGIN=0                   # 1이면 'dev:<id>' 토큰으로 구글 자리에 로그인 (개발 전용)
CORS_ORIGINS=http://localhost:8081

# 카페 수집
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# 계정 연결 (수집용 키와 별개). 운영자의 비밀 저장소에만 설정
NAVER_LOGIN_ENABLED=0
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI= # https://실제API도메인/v1/social/instagram/callback
# RevenueCat 서버 API v1 키. 앱의 공개 SDK 키와 별개
REVENUECAT_SECRET_KEY=
PREMIUM_ENTITLEMENT=photospot_plus
# 이용자가 동의하고 관리자가 개인정보를 제거한 의견만 전송
OPENAI_API_KEY=
FEEDBACK_MODEL=gpt-4o-mini
