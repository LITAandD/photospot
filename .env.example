# 복사해서 .env 로 쓰고, 운영 값은 비밀 저장소(예: SSM, Vault, GitHub Secrets)에 둔다
APP_ENV=development
DATABASE_URL=postgresql://photospot:photospot@db:5432/photospot
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_ROOT=/data/storage
MEDIA_BASE_URL=/media
ANTHROPIC_API_KEY=
TOURAPI_KEY=
PHOTO_MASKER=none            # rembg 로 바꾸면 인물 제외 (모델 다운로드 필요)

# 소셜 로그인
GOOGLE_CLIENT_IDS=            # iOS,Android,웹 클라이언트 ID를 쉼표로
APPLE_AUDIENCES=app.photospot # 번들 ID (웹 로그인도 쓰면 서비스 ID 추가)
APPLE_CLIENT_ID=app.photospot
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=     # 서버에만 마운트한 Sign in with Apple .p8 파일
APPLE_TOKEN_ENCRYPTION_KEY= # Fernet 키. 서버 비밀 저장소에 보관하고 DB 백업과 분리
RECOMMENDATION_BACKEND=catalog
# Docker 이미지에는 공개 장소 스냅샷 포함. 로컬은 storage/place-catalog.sqlite3 사용
KAKAO_APP_ID=                 # 카카오 개발자 콘솔의 앱 ID (숫자)
DEV_LOGIN=0                   # 1이면 'dev:<id>' 토큰으로 구글 자리에 로그인 (개발 전용)
CORS_ORIGINS=http://localhost:8081

# 네이버 (서버 전용, 앱에 넣지 말 것). 카페 수집(검색 API)과 네이버 로그인이 같은 키를 쓴다:
# 개발자 센터의 한 애플리케이션에 두 API를 모두 켜고, 로그인 Callback URL(예: photospot://oauth/naver)을 등록한다.
# 앱은 인가 코드만 받아 POST /v1/auth/naver 로 보내고, 토큰 교환은 서버가 이 비밀키로 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카페 수집
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# 계정 연결. 운영자의 비밀 저장소에만 설정
NAVER_LOGIN_ENABLED=0         # 1이어도 NAVER_CLIENT_ID·NAVER_CLIENT_SECRET이 있어야 켜진다
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI= # https://실제API도메인/v1/social/instagram/callback
# RevenueCat 서버 API v1 키. 앱의 공개 SDK 키와 별개
REVENUECAT_SECRET_KEY=
PREMIUM_ENTITLEMENT=photospot_plus
# 이용자가 동의하고 관리자가 개인정보를 제거한 의견만 전송
OPENAI_API_KEY=
FEEDBACK_MODEL=gpt-4o-mini

# 공식 매장·브랜드 사진(예: © Starbucks Korea)은 재사용 허락이 없어 기본으로 표시하지 않는다.
# 저작권자의 서면 허락을 받은 경우에만 1로 설정 (CC·퍼블릭 도메인 사진은 항상 표시)
ALLOW_OFFICIAL_BRAND_PHOTOS=0

# 클라이언트 IP별 분당 요청 한도 (/v1/auth/*, 미리보기 /preview/*). 0이면 끔.
# 프로세스 메모리에서 세므로 워커·인스턴스마다 따로 센다. 프록시 뒤에서는 uvicorn --proxy-headers 필요
RATE_LIMIT_AUTH_PER_MIN=60
RATE_LIMIT_PREVIEW_PER_MIN=120

# 작업 처리기: 이 시간(초)보다 오래 running 인 작업은 처리기 중단으로 보고 다시 대기열에 넣는다
JOB_LOCK_TIMEOUT_S=1800
